{
  "name": "ashen-support-web", "version": "0.1.0", "private": true, "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1", "build": "vue-tsc --noEmit && vite build", "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit", "lint": "eslint src", "test:unit": "vitest run", "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {"vue": "^3.5.0", "vue-router": "^4.5.0", "pinia": "^3.0.0", "naive-ui": "^2.41.0"},
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0", "vite": "^7.0.0", "typescript": "^5.8.0", "vue-tsc": "^3.0.0",
    "vitest": "^3.2.0", "@playwright/test": "^1.51.0", "eslint": "^9.22.0", "eslint-plugin-vue": "^10.0.0",
    "typescript-eslint": "^8.26.0", "openapi-typescript": "^7.6.0"
  }
}
